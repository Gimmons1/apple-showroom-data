import json
import requests

def get_enriched_specs(name, category, chip, year):
    # Specifiche di base sempre presenti
    specs = {
        "Introduced": year,
        "Architecture": "64-bit Apple Silicon" if "M" in chip or "A" in chip else "64-bit Intel Core"
    }
    
    # Motore di generazione specifiche reali in base alla categoria
    if category == "iPhone":
        specs["Display"] = "Super Retina XDR OLED display"
        specs["Camera"] = "Advanced Dual Camera with Photonic Engine"
        specs["Biometrics"] = "Face ID via Secure Enclave"
        specs["Battery"] = "Built-in rechargeable lithium-ion"
        specs["Connector"] = "Lightning port"
        
        if "15 Pro" in name or "16 Pro" in name:
            specs["Display"] = "Super Retina XDR OLED, ProMotion 120Hz, Always-On"
            specs["Camera"] = "48MP Main | 12MP Ultra Wide | 12MP 5x Telephoto"
            specs["Material"] = "Aerospace-grade Titanium design"
            specs["Connector"] = "USB-C with USB 3 speed (up to 10Gb/s)"
        elif "14 Pro" in name:
            specs["Display"] = "Super Retina XDR OLED with Dynamic Island"
            specs["Camera"] = "48MP Main | 12MP Ultra Wide | 12MP 3x Telephoto"
        elif "15" in name or "16" in name:
            specs["Display"] = "Super Retina XDR OLED with Dynamic Island"
            specs["Connector"] = "USB-C (USB 2 speed)"
            
    elif category == "Mac":
        specs["Memory"] = "Unified Memory Architecture (UMA)"
        specs["Storage"] = "Apple PCIe NVMe Onboard SSD"
        specs["Audio"] = "Stereo speakers with Wide Stereo Sound"
        
        if "MacBook Air" in name:
            specs["Display"] = "Liquid Retina display with True Tone, 500 nits"
            specs["Design"] = "Ultra-slim aluminum unibody, fanless quiet design"
            specs["Ports"] = "2x Thunderbolt / USB 4 ports, MagSafe 3, Headphone jack"
            if "M3" in name:
                specs["External Displays"] = "Supports up to two external displays"
        elif "MacBook Pro" in name:
            specs["Display"] = "Liquid Retina XDR (Mini-LED), ProMotion 120Hz, 1600 nits"
            specs["Ports"] = "3x Thunderbolt 4, HDMI port, SDXC Card Slot, MagSafe 3"
            specs["Audio"] = "High-fidelity six-speaker sound system with force-cancelling woofers"
        elif "Mac Studio" in name:
            specs["Ports"] = "4x or 6x Thunderbolt 4, 2x USB-A, 10Gb Ethernet, HDMI"
            specs["Cooling"] = "Advanced double-sided blower thermal system"
        elif "Mac mini" in name:
            specs["Ports"] = "2x or 4x Thunderbolt 4, 2x USB-A, Gigabit Ethernet, HDMI"
            
    elif category == "iPad":
        specs["Biometrics"] = "Touch ID or Face ID"
        specs["Connectivity"] = "Wi-Fi 6 / 6E, Bluetooth, Optional 5K Cellular"
        
        if "Pro" in name and "M4" in name:
            specs["Display"] = "Ultra Retina XDR (Tandem OLED), 1600 nits"
            specs["Thickness"] = "5.1mm - Thinnest Apple product ever"
            specs["Camera"] = "12MP Wide camera | LiDAR Scanner for 3D mapping"
        elif "Air" in name:
            specs["Display"] = "Liquid Retina display with anti-reflective coating"
            specs["Biometrics"] = "Touch ID integrated in top button"
            
    return specs

def build_apple_database():
    print("📡 Download dell'intero catalogo da AppleDB...")
    url = "https://api.appledb.dev/device/main.json"
    
    try:
        response = requests.get(url)
        data = response.json()
        raw_list = data if isinstance(data, list) else list(data.values())
        
        apple_devices = []
        
        for item in raw_list:
            name = item.get("name", "")
            device_type = item.get("type", "")
            
            # Filtro per mantenere lo showroom pulito ed esclusivo
            if device_type not in ["Mac", "iPhone", "iPad"] or "beta" in name.lower():
                continue
                
            released = item.get("released", [""])
            release_date = released[0] if isinstance(released, list) and len(released) > 0 else (released if isinstance(released, str) else "")
            year = release_date[:4] if len(release_date) >= 4 else "2024"
            
            # Escludiamo i modelli estremamente vecchi per ottimizzare la fluidità
            if int(year) < 2021:
                continue
                
            chip = item.get("soc", "Apple Silicon")
            category = device_type
            
            # Configurazione estetica Liquid Glass coordinata
            theme_color = "#FFFFFF"
            tagline = "Designed by Apple in California."
            
            if category == "iPhone":
                theme_color = "#8A8B8C" if "Pro" in name else "#A7C7E7"
                tagline = "Pro. Beyond." if "Pro" in name else "A total powerhouse."
            elif "MacBook Pro" in name:
                theme_color = "#5A5B5D"
                tagline = "Minds blown. Catch you later."
            elif "MacBook Air" in name:
                theme_color = "#2E3B4E"
                tagline = "Lean. Mean. M3 machine."
            elif "Mac" in name:
                theme_color = "#007AFF"
                tagline = "Supercharged for pros."
            elif "iPad" in name:
                theme_color = "#FF2D55" if "Pro" in name else "#4A90E2"
                tagline = "Thinpossible." if "Pro" in name else "Lovable. Drawable. Magical."

            # Generazione automatica delle specifiche dettagliate
            enriched_specs = get_enriched_specs(name, category, chip, year)
            
            # Integrazione codici hardware utili di AppleDB
            if "identifier" in item:
                enriched_specs["Model ID"] = item["identifier"]

            apple_devices.append({
                "id": item.get("key", name.replace(" ", "-").lower()),
                "name": name,
                "chip": chip,
                "releaseYear": year,
                "category": category,
                "tagline": tagline,
                "themeColor": theme_color,
                "specs": enriched_specs
            })
            
        # Ordinamento cronologico
        apple_devices.sort(key=lambda x: x["releaseYear"], reverse=True)
        
        with open("apple_database.json", "w", encoding="utf-8") as f:
            json.dump(apple_devices, f, indent=2, ensure_ascii=False)
            
        print(f"✅ Finito! Creato 'apple_database.json' ricco di dettagli per {len(apple_devices)} dispositivi.")
        
    except Exception as e:
        print(f"❌ Errore: {e}")

if __name__ == "__main__":
    build_apple_database()
